{{ 'rda-construction.css' | asset_url | stylesheet_tag }}

{%- if section.settings.show_bar -%}
<div
  class="rda-announce-wrap"
  style="
    --ann-bg: {{ section.settings.color_bg }};
    --ann-accent: {{ section.settings.color_accent }};
    --ann-heading: {{ section.settings.color_heading }};
    --ann-sub: {{ section.settings.color_sub }};
    --ann-btn-bg: {{ section.settings.color_btn_bg }};
    --ann-btn-text: {{ section.settings.color_btn_text }};
    --ann-link-color: {{ section.settings.color_link }};
    --ann-icon-border: {{ section.settings.color_icon_border }};
    --ann-divider: {{ section.settings.color_divider }};
    --ann-label: {{ section.settings.color_label }};
  "
>
  <div class="rda-announce page-width">

    {%- comment -%} Background photo fading in from right {%- endcomment -%}
    {%- if section.settings.bg_image -%}
      <div class="rda-announce__photo" aria-hidden="true">
        {{ section.settings.bg_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: '' }}
      </div>
    {%- endif -%}

    {%- comment -%} Left: icon + label {%- endcomment -%}
    <div class="rda-announce__icon-col">
      <div class="rda-announce__icon-circle" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="7" width="20" height="14" rx="2"/>
          <path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/>
          <line x1="12" y1="12" x2="12" y2="12.01"/>
          <path d="M2 12h20"/>
        </svg>
      </div>
      <span class="rda-announce__icon-label">{{ section.settings.icon_label }}</span>
    </div>

    <div class="rda-announce__vdivider" aria-hidden="true"></div>

    {%- comment -%} Center: heading + subtext {%- endcomment -%}
    <div class="rda-announce__text-col">
      <p class="rda-announce__heading">
        <span class="rda-announce__heading-plain">{{ section.settings.heading_plain }} </span>
        <span class="rda-announce__heading-accent">{{ section.settings.heading_accent }}</span>
      </p>
      {%- if section.settings.subtext != blank -%}
        <p class="rda-announce__sub">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>

    {%- comment -%} Right: buttons {%- endcomment -%}
    <div class="rda-announce__btns">
      {%- if section.settings.btn_label != blank -%}
        <a href="{{ section.settings.btn_url | default: '#' }}" class="rda-announce__btn-primary">
          <span class="rda-announce__btn-arrow" aria-hidden="true">→</span>
          {{ section.settings.btn_label }}
        </a>
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <div class="rda-announce__vdivider" aria-hidden="true"></div>
        <a href="{{ section.settings.link_url | default: '#' }}" class="rda-announce__btn-link">
          {{ section.settings.link_label }}
          <span aria-hidden="true"> ›</span>
        </a>
      {%- endif -%}
    </div>

  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_bar",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "header",
      "content": "Icon"
    },
    {
      "type": "text",
      "id": "icon_label",
      "label": "Icon label",
      "default": "WE'RE HIRING"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading_plain",
      "label": "Heading — plain part",
      "default": "We're Hiring"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading — accent part (gold)",
      "default": "Skilled Team Members"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Join our growing team — carpenters, installers, and site staff wanted."
    },
    {
      "type": "header",
      "content": "Primary button"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button label",
      "default": "Apply Now"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Text link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "header",
      "content": "Background image"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Right-side background image"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Card background",
      "default": "#192140"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Accent / gold",
      "default": "#C4860A"
    },
    {
      "type": "color",
      "id": "color_heading",
      "label": "Heading plain text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_sub",
      "label": "Subtext",
      "default": "#b0b8c8"
    },
    {
      "type": "color",
      "id": "color_btn_bg",
      "label": "Button background",
      "default": "#C4860A"
    },
    {
      "type": "color",
      "id": "color_btn_text",
      "label": "Button text",
      "default": "#192140"
    },
    {
      "type": "color",
      "id": "color_link",
      "label": "Text link color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_icon_border",
      "label": "Icon circle border",
      "default": "#C4860A"
    },
    {
      "type": "color",
      "id": "color_divider",
      "label": "Divider line",
      "default": "#2e3d5c"
    },
    {
      "type": "color",
      "id": "color_label",
      "label": "Icon label text",
      "default": "#C4860A"
    }
  ],
  "presets": [
    {
      "name": "Announcement bar"
    }
  ]
}
{% endschema %}
