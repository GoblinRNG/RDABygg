{{ 'rda-construction.css' | asset_url | stylesheet_tag }}

<section class="rda-image-banner">
  {% if section.settings.image %}
    {{ section.settings.image | image_url: width: 1920 | image_tag: loading: 'lazy', alt: section.settings.heading, class: 'rda-image-banner__bg' }}
  {% endif %}
  <div class="rda-image-banner__overlay"></div>
  <div class="rda-image-banner__content">
    {% if section.settings.heading != blank %}
      <h1 class="rda-image-banner__heading">{{ section.settings.heading }}</h1>
    {% endif %}
    {% if section.settings.subtext != blank %}
      <p class="rda-image-banner__subtext">{{ section.settings.subtext }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "RDA Image Banner",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Page Title"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "A brief description of this page."
    }
  ],
  "presets": [
    {
      "name": "RDA Image Banner"
    }
  ]
}
{% endschema %}
