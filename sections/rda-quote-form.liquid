{{ 'rda-construction.css' | asset_url | stylesheet_tag }}

<section class="rda-section">
  <div class="rda-container">
    <div class="rda-section-header rda-section-header--center">
      {% if section.settings.heading != blank %}
        <h2 class="rda-section-title">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subtext != blank %}
        <p class="rda-section-subtitle">{{ section.settings.subtext }}</p>
      {% endif %}
    </div>
    <div class="rda-quote-form__inner">
      {% form 'contact' %}
        {% if form.posted_successfully? %}
          <div class="rda-form-success" role="alert">
            {{ section.settings.success_message | default: 'Thank you! We will be in touch shortly.' }}
          </div>
        {% endif %}
        {% if form.errors %}
          <div class="rda-form-error" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="rda-form-row rda-form-row--2">
          <div class="rda-form-group">
            <label class="rda-form-label rda-form-label--required" for="contact-name">{{ 'contact.form.name' | t | default: 'Name' }}</label>
            <input
              type="text"
              id="contact-name"
              name="contact[name]"
              class="rda-form-input"
              value="{{ form.name }}"
              required
              autocomplete="name"
            >
          </div>
          <div class="rda-form-group">
            <label class="rda-form-label rda-form-label--required" for="contact-email">{{ 'contact.form.email' | t | default: 'Email' }}</label>
            <input
              type="email"
              id="contact-email"
              name="contact[email]"
              class="rda-form-input"
              value="{{ form.email }}"
              required
              autocomplete="email"
            >
          </div>
        </div>

        <div class="rda-form-row rda-form-row--2">
          <div class="rda-form-group">
            <label class="rda-form-label" for="contact-phone">{{ section.settings.phone_label | default: 'Phone number' }}</label>
            <input
              type="tel"
              id="contact-phone"
              name="contact[phone]"
              class="rda-form-input"
              autocomplete="tel"
            >
          </div>
          <div class="rda-form-group">
            <label class="rda-form-label" for="contact-project-type">{{ section.settings.project_type_label | default: 'Project type' }}</label>
            <select id="contact-project-type" name="contact[project_type]" class="rda-form-select">
              <option value="">-- Select --</option>
              <option value="Carpentry">Carpentry</option>
              <option value="Renovation">Renovation</option>
              <option value="Decking">Decking</option>
              <option value="Flooring">Flooring</option>
              <option value="Doors & Windows">Doors &amp; Windows</option>
              <option value="Kitchen Carpentry">Kitchen Carpentry</option>
              <option value="Walls & Framing">Walls &amp; Framing</option>
              <option value="Custom Woodwork">Custom Woodwork</option>
              <option value="Repairs & Maintenance">Repairs &amp; Maintenance</option>
              <option value="Other">Other</option>
            </select>
          </div>
        </div>

        <div class="rda-form-row">
          <div class="rda-form-group">
            <label class="rda-form-label" for="contact-contact-method">{{ section.settings.contact_method_label | default: 'Preferred contact method' }}</label>
            <select id="contact-contact-method" name="contact[preferred_contact]" class="rda-form-select">
              <option value="Email">Email</option>
              <option value="Phone">Phone</option>
              <option value="Either">Either</option>
            </select>
          </div>
        </div>

        <div class="rda-form-row">
          <div class="rda-form-group">
            <label class="rda-form-label rda-form-label--required" for="contact-message">{{ 'contact.form.message' | t | default: 'Message' }}</label>
            <textarea
              id="contact-message"
              name="contact[body]"
              class="rda-form-textarea"
              required
              placeholder="{{ section.settings.message_placeholder | default: 'Describe your project — location, scope, and any relevant details.' }}"
            >{{ form.body }}</textarea>
          </div>
        </div>

        <button type="submit" class="rda-form-submit">
          {{ section.settings.submit_label | default: 'Send Quote Request' }}
        </button>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "RDA Quote Form",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Request a Free Quote"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Fill in the form below and we will get back to you within one business day."
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone field label",
      "default": "Phone number"
    },
    {
      "type": "text",
      "id": "project_type_label",
      "label": "Project type label",
      "default": "Project type"
    },
    {
      "type": "text",
      "id": "contact_method_label",
      "label": "Contact method label",
      "default": "Preferred contact method"
    },
    {
      "type": "text",
      "id": "message_placeholder",
      "label": "Message placeholder",
      "default": "Describe your project — location, scope, and any relevant details."
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit button label",
      "default": "Send Quote Request"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you! We will be in touch shortly."
    }
  ],
  "presets": [
    {
      "name": "RDA Quote Form"
    }
  ]
}
{% endschema %}
