{{ 'rda-construction.css' | asset_url | stylesheet_tag }}

<section class="rda-hero">
  {% if section.settings.hero_image %}
    {{ section.settings.hero_image | image_url: width: 1920 | image_tag: loading: 'lazy', alt: section.settings.heading, class: 'rda-hero__bg' }}
  {% endif %}
  <div class="rda-hero__overlay"></div>
  <div class="rda-hero__content">
    {% if section.settings.company_name != blank %}
      <p class="rda-hero__company">{{ section.settings.company_name }}</p>
    {% endif %}
    <h1 class="rda-hero__heading">{{ section.settings.heading }}</h1>
    {% if section.settings.subtext != blank %}
      <p class="rda-hero__subtext">{{ section.settings.subtext }}</p>
    {% endif %}
    <div class="rda-hero__ctas">
      {% if section.settings.cta_primary_label != blank and section.settings.cta_primary_url != blank %}
        <a href="{{ section.settings.cta_primary_url }}" class="rda-btn rda-btn--primary">{{ section.settings.cta_primary_label }}</a>
      {% endif %}
      {% if section.settings.cta_secondary_label != blank and section.settings.cta_secondary_url != blank %}
        <a href="{{ section.settings.cta_secondary_url }}" class="rda-btn rda-btn--secondary">{{ section.settings.cta_secondary_label }}</a>
      {% endif %}
    </div>
    <div class="rda-hero__trust-badges">
      {% for block in section.blocks %}
        {% if block.type == 'trust_badge' %}
          <span class="rda-hero__badge" {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "RDA Hero",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero background image"
    },
    {
      "type": "text",
      "id": "company_name",
      "label": "Company name",
      "default": "RDA Bygg AB"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Expert Carpentry & Construction in Stockholm"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Professional renovation, decking, flooring, doors, windows, and custom woodwork. Swedish craftsmanship you can trust."
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Primary button label",
      "default": "Request a Quote"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary button URL"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Secondary button label",
      "default": "View Projects"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary button URL"
    }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Trust Badge",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Badge label",
          "default": "Registered Company"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "RDA Hero",
      "blocks": [
        {
          "type": "trust_badge",
          "settings": {
            "label": "Registered Company"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "label": "Swedish Work Standards"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "label": "Free Consultation"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "label": "Carpentry Specialists"
          }
        }
      ]
    }
  ]
}
{% endschema %}
