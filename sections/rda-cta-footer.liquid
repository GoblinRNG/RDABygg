{{ 'rda-construction.css' | asset_url | stylesheet_tag }}

<section class="rda-section rda-cta-footer">
  <div class="rda-container">
    {% if section.settings.heading != blank %}
      <h2 class="rda-section-title">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subtext != blank %}
      <p class="rda-cta-footer__subtext">{{ section.settings.subtext }}</p>
    {% endif %}
    <div class="rda-cta-footer__btns">
      {% if section.settings.btn1_label != blank and section.settings.btn1_url != blank %}
        <a href="{{ section.settings.btn1_url }}" class="rda-btn rda-btn--secondary">{{ section.settings.btn1_label }}</a>
      {% endif %}
      {% if section.settings.btn2_label != blank and section.settings.btn2_url != blank %}
        <a href="{{ section.settings.btn2_url }}" class="rda-btn rda-btn--outline" style="color:#fff;border-color:rgba(255,255,255,0.6);">{{ section.settings.btn2_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "RDA CTA Footer",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Need reliable carpentry work?"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Get in touch today for a free consultation and quote. No obligation."
    },
    {
      "type": "text",
      "id": "btn1_label",
      "label": "Button 1 label",
      "default": "Request a Quote"
    },
    {
      "type": "url",
      "id": "btn1_url",
      "label": "Button 1 URL"
    },
    {
      "type": "text",
      "id": "btn2_label",
      "label": "Button 2 label",
      "default": "View Our Projects"
    },
    {
      "type": "url",
      "id": "btn2_url",
      "label": "Button 2 URL"
    }
  ],
  "presets": [
    {
      "name": "RDA CTA Footer"
    }
  ]
}
{% endschema %}
